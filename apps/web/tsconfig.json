{
    "extends": "../../tsconfig.base.json",

    "compilerOptions": {

        "target": "ES2022",

        "module": "ESNext",

        "moduleResolution": "Bundler",

        "jsx": "react-jsx",

        "strict": true,

        "isolatedModules": true,

        "noEmit": true,

        "allowSyntheticDefaultImports": true,

        "esModuleInterop": true,

        "skipLibCheck": true,

        "types": [
            "vite/client"
        ]

    },

    "include": [
        "src"
    ]
}