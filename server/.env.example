PORT=4302
NODE_ENV=development

# Security: the server only listens on loopback and accepts the listed frontend origins.
HOST=127.0.0.1
JUSTAI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional fixed access token (random per start when empty). Written to .justai/runtime.json.
JUSTAI_TOKEN=

# Agent
# Default provider for new sessions: anthropic | openai | mock
JUSTAI_PROVIDER=mock
# Budget per run of the agent loop
JUSTAI_MAX_AGENT_STEPS=100
JUSTAI_MAX_OUTPUT_TOKENS=1000000
JUSTAI_MAX_WALL_TIME_MS=3600000

# Anthropic (also works with ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=64000
# low | medium | high | xhigh | max, or "off" to omit
ANTHROPIC_EFFORT=high
# Server-side fallback model on refusals: "off" to disable
ANTHROPIC_FALLBACKS=default

# OpenAI (Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=
OPENAI_MAX_TOKENS=64000
# minimal | low | medium | high, or "off" for models without reasoning
OPENAI_REASONING_EFFORT=medium

# Microsoft OneDrive / Word
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:4302/api/integrations/microsoft/callback

# Encrypts the local Microsoft refresh token store.
# Use a long random secret in real deployments.
JUSTAI_ENCRYPTION_KEY=
