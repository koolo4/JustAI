PORT=4302
NODE_ENV=development

# Security: the server only listens on loopback and accepts the listed frontend origins.
HOST=127.0.0.1
JUSTAI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional fixed access token (random per start when empty). Written to .justai/runtime.json.
JUSTAI_TOKEN=

# AI
JUSTAI_PROVIDER=mock
JUSTAI_MAX_AGENT_STEPS=8

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=4096

# Microsoft OneDrive / Word
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:4302/api/integrations/microsoft/callback

# Encrypts the local Microsoft refresh token store.
# Use a long random secret in real deployments.
JUSTAI_ENCRYPTION_KEY=
