PORT=4302
NODE_ENV=development

# AI
JUSTAI_PROVIDER=mock
JUSTAI_MAX_AGENT_STEPS=8

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=4096

# Microsoft OneDrive / Word
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:4302/api/integrations/microsoft/callback

# Encrypts the local Microsoft refresh token store.
# Use a long random secret in real deployments.
JUSTAI_ENCRYPTION_KEY=

# Browser AI Council (no API keys; local persistent browser sessions)
# Optional: msedge, chrome, or leave blank to use Playwright Chromium.
JUSTAI_BROWSER_CHANNEL=msedge
JUSTAI_COUNCIL_TIMEOUT_MS=120000
