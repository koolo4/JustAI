PORT=4302
NODE_ENV=development

# Security: the server only listens on loopback and accepts the listed frontend origins.
HOST=127.0.0.1
JUSTAI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional fixed access token (random per start when empty). Written to .justai/runtime.json.
JUSTAI_TOKEN=

# Agent
# Default provider for new sessions: anthropic | openai | mock
JUSTAI_PROVIDER=mock
# Budget per run of the agent loop
JUSTAI_MAX_AGENT_STEPS=100
JUSTAI_MAX_OUTPUT_TOKENS=1000000
JUSTAI_MAX_WALL_TIME_MS=3600000

# Anthropic (also works with ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=64000
# low | medium | high | xhigh | max, or "off" to omit
ANTHROPIC_EFFORT=high
# Server-side fallback model on refusals: "off" to disable
ANTHROPIC_FALLBACKS=default

# OpenAI (Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=
OPENAI_MAX_TOKENS=64000
# minimal | low | medium | high, or "off" for models without reasoning
OPENAI_REASONING_EFFORT=medium

# --- OpenAI-compatible providers (free tiers and local models) ---
# Each preset reads <PREFIX>_BASE_URL, <PREFIX>_MODEL, <PREFIX>_MAX_TOKENS and its key.
# Free model lists change often: check the provider's site for current model names.

# Ollama (local). Start it with a large context window, otherwise prompts are cut silently:
#   PowerShell (8 ГБ видеопамяти):  $env:OLLAMA_CONTEXT_LENGTH=16384; $env:OLLAMA_FLASH_ATTENTION=1; $env:OLLAMA_KV_CACHE_TYPE="q8_0"; ollama serve
# qwen3:8b без «размышлений» прошла 3 из 4 живых прогонов (~25 с на задачу); qwen2.5-coder:7b — примерно 1 из 4.
OLLAMA_MODEL=qwen3:8b
# "none" отключает размышления qwen3: успех тот же, а работает в разы быстрее.
OLLAMA_REASONING_EFFORT=none
OLLAMA_BASE_URL=
# Must match OLLAMA_CONTEXT_LENGTH: JustAI trims old history to fit this window.
# (<PREFIX>_CONTEXT works for every preset; default 32768 for local servers, 128000 for cloud.)
OLLAMA_CONTEXT=16384
# LM Studio (local server, OpenAI mode)
LMSTUDIO_MODEL=
# OpenRouter: free models end with ":free"
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Groq
GROQ_API_KEY=
GROQ_MODEL=
# Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=
# GitHub Models (a GitHub token with models access)
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=
# DeepSeek (paid, inexpensive)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# --- Self-verification ---
# Project checks run after the agent changes files: any of build,typecheck,lint,test, or "off".
JUSTAI_VERIFY=typecheck,test
JUSTAI_VERIFY_TIMEOUT_MS=300000
# Browser for checking the local UI: empty = Playwright Chromium, falls back to Edge on Windows.
JUSTAI_BROWSER_CHANNEL=
# Model for read-only helper agents (spawn_agent); empty = the session's own model.
JUSTAI_SUBAGENT_PROVIDER=

# --- Planner + local executor ---
# Provider that runs delegated steps for the "Planner + local executor" profile.
JUSTAI_EXECUTOR_PROVIDER=ollama
JUSTAI_EXECUTOR_MAX_STEPS=40

# Microsoft OneDrive / Word
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:4302/api/integrations/microsoft/callback

# Encrypts the local Microsoft refresh token store.
# Use a long random secret in real deployments.
JUSTAI_ENCRYPTION_KEY=
