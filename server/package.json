{
  "name": "@justai/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "predev": "npm run build -w @justai/shared",
    "pretest": "npm run build -w @justai/shared",
    "pretypecheck": "npm run build -w @justai/shared",
    "prebuild": "npm run build -w @justai/shared"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@justai/shared": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vscode/ripgrep": "^1.18.0",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "openai": "^7.40.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.1",
    "playwright": "^1.55.0",
    "turndown": "^7.2.4",
    "undici": "^8.12.3",
    "ws": "^8.21.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "supertest": "^7.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
